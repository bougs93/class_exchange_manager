rules_version = '2';

// 웹 전환 2단계, 계획서 4.4절.
//
// - config/public: 로그인 화면 안내문 — 누구나 읽기 가능
// - config/auth: 비밀번호 salted 해시 — 익명 로그인 후 읽기 가능
//   (평문 노출 방지용 최소 분리. 작정한 익명 사용자의 직접 읽기는
//   요구사항상 허용된 리스크)
// - config/sharedTimetable: 버전 마커 — 읽기 공개, 쓰기 로그인 필요
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/public {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/auth {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /config/sharedTimetable {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
